# GitHub has no typeshi grammar yet. typeshi is Rust tokens, so highlight it as Rust.
*.shi linguist-language=Rust
# the .rs next to every .shi is generated by typeshi. nobody can edit it.
examples/**/src/lib.rs linguist-generated=true
# the site's compiler is the crate in site/wasm, built by site/scripts/build-wasm.sh. so is its glue.
site/public/typeshi.wasm binary linguist-generated=true
site/src/wasm/** linguist-generated=true
site/src/generated/** linguist-generated=true
