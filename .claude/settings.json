{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo build *)",
      "Bash(cargo test *)",
      "Bash(cargo check *)",
      "Bash(cargo fmt *)",
      "Bash(cargo clippy *)",
      "Bash(cargo run -- check *)",
      "Bash(npm ci *)",
      "Bash(npm install)",
      "Bash(npm run typecheck *)",
      "Bash(npm test *)",
      "Bash(npm run build *)",
      "Bash(npm run e2e *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push -u origin claude/*)",
      "Bash(git push origin claude/*)",
      "Bash(git -c push.negotiate=true push -u origin claude/*)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr status *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh api *)"
    ],
    "ask": [
      "Bash(git push origin claude/* *)",
      "Bash(git push -u origin claude/* *)",
      "Bash(git -c push.negotiate=true push -u origin claude/* *)",
      "Bash(git push *:*)",
      "Bash(git -c push.negotiate=true push *:*)",
      "Bash(gh api -X*)",
      "Bash(gh api * -X*)",
      "Bash(gh api --method*)",
      "Bash(gh api * --method*)",
      "Bash(gh api -f*)",
      "Bash(gh api * -f*)",
      "Bash(gh api -F*)",
      "Bash(gh api * -F*)",
      "Bash(gh api --field*)",
      "Bash(gh api * --field*)",
      "Bash(gh api --raw-field*)",
      "Bash(gh api * --raw-field*)",
      "Bash(gh api --input*)",
      "Bash(gh api * --input*)",
      "Bash(gh pr merge *)",
      "Bash(vercel *--prod*)",
      "Bash(npx vercel *--prod*)",
      "Bash(vercel promote *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Bash(vercel env pull*)",
      "Bash(npx vercel env pull*)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
