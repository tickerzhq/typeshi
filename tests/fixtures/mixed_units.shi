// one SOL deposited credits 1,000 USDC: `amount` is SOL, `vault.usdc` is USDC.
// typeshi refuses it (SHI002). run `typeshi explain SHI002`.

gm!("7PxhmDuhhe394QJgKyW1P7Ce4dPCfFPN2yKq4KCCj7Vj");

stealth_launch vault {
    ticker USDC = 6;
    ticker SOL = 9;

    frame Vault {
        cabal: Pubkey,
        usdc: USDC,
    }

    cap_table Deposit {
        #[account(mut, has_one = cabal)]
        vault: Account<Vault>,
        cabal,
    }

    lock_in fn deposit(ctx, amount: SOL) -> W {
        mark_to_market!(vault.usdc = per_my_last_email!(vault.usdc) + amount);
        were_so_back!()
    }
}
