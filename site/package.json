{
  "name": "typeshi-site",
  "private": true,
  "type": "module",
  "scripts": {
    "tokens": "node scripts/tokens.mjs",
    "sync": "node scripts/sync.mjs",
    "predev": "node scripts/tokens.mjs && node scripts/sync.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/tokens.mjs && node scripts/sync.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs",
    "e2e": "playwright test --trace off",
    "wasm": "./scripts/build-wasm.sh && node scripts/sync.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.8",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@vercel/analytics": "2.0.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
