{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "typeshi's design tokens. The default resolution is dark with normal contrast; light.json and contrast-more.json are the other contexts (typeshi.resolver.json). scripts/tokens.mjs turns them into src/app/tokens.css, src/lib/tokens.ts and src/app/icon.svg.",
  "palette": {
    "$type": "color",
    "$description": "Primitives in OKLCH. The step is (1 - lightness) x 1000, so a bigger number is darker and equal steps look equally far apart.",
    "gray": {
      "0": { "$value": {"colorSpace": "oklch", "components": [1, 0, 270]} },
      "15": { "$value": {"colorSpace": "oklch", "components": [0.985, 0.002, 270]} },
      "25": { "$value": {"colorSpace": "oklch", "components": [0.975, 0.003, 270]} },
      "35": { "$value": {"colorSpace": "oklch", "components": [0.965, 0.003, 270]} },
      "50": { "$value": {"colorSpace": "oklch", "components": [0.95, 0.003, 270]} },
      "80": { "$value": {"colorSpace": "oklch", "components": [0.92, 0.004, 270]} },
      "140": { "$value": {"colorSpace": "oklch", "components": [0.86, 0.006, 270]} },
      "230": { "$value": {"colorSpace": "oklch", "components": [0.77, 0.008, 270]} },
      "370": { "$value": {"colorSpace": "oklch", "components": [0.63, 0.01, 270]} },
      "470": { "$value": {"colorSpace": "oklch", "components": [0.53, 0.012, 270]} },
      "560": { "$value": {"colorSpace": "oklch", "components": [0.44, 0.012, 270]} },
      "670": { "$value": {"colorSpace": "oklch", "components": [0.33, 0.008, 270]} },
      "745": { "$value": {"colorSpace": "oklch", "components": [0.255, 0.007, 270]} },
      "780": { "$value": {"colorSpace": "oklch", "components": [0.22, 0.006, 270]} },
      "825": { "$value": {"colorSpace": "oklch", "components": [0.175, 0.005, 270]} },
      "855": { "$value": {"colorSpace": "oklch", "components": [0.145, 0.004, 270]} },
      "880": { "$value": {"colorSpace": "oklch", "components": [0.12, 0.004, 270]} },
      "890": { "$value": {"colorSpace": "oklch", "components": [0.11, 0.004, 270]} },
      "$description": "Neutrals with a trace of blue (hue 270)."
    },
    "lime": {
      "70": { "$value": {"colorSpace": "oklch", "components": [0.93, 0.17, 128]} },
      "110": { "$value": {"colorSpace": "oklch", "components": [0.89, 0.19, 128]} },
      "480": { "$value": {"colorSpace": "oklch", "components": [0.52, 0.15, 135]} },
      "700": { "$value": {"colorSpace": "oklch", "components": [0.3, 0.04, 130]} },
      "800": { "$value": {"colorSpace": "oklch", "components": [0.2, 0.03, 130]} },
      "$description": "wagmi. The one accent."
    },
    "red": {
      "200": { "$value": {"colorSpace": "oklch", "components": [0.8, 0.1, 25]} },
      "290": {
        "$value": { "colorSpace": "oklch", "components": [0.71, 0.182, 25] },
        "$extensions": { "com.tickerz.typeshi": {"p3": [0.71, 0.19, 25]} },
        "$description": "Mapped into sRGB. Screens with Display P3 get the full chroma from the extension."
      },
      "460": { "$value": {"colorSpace": "oklch", "components": [0.54, 0.2, 27]} },
      "$description": "ngmi, rustc's error red."
    },
    "amber": {
      "150": { "$value": {"colorSpace": "oklch", "components": [0.85, 0.14, 85]} },
      "470": { "$value": {"colorSpace": "oklch", "components": [0.53, 0.11, 70]} },
      "$description": "Warnings, confessions."
    },
    "violet": {
      "210": { "$value": {"colorSpace": "oklch", "components": [0.79, 0.1, 300]} },
      "500": { "$value": {"colorSpace": "oklch", "components": [0.5, 0.17, 300]} }
    },
    "sand": {
      "160": { "$value": {"colorSpace": "oklch", "components": [0.84, 0.09, 75]} },
      "500": { "$value": {"colorSpace": "oklch", "components": [0.5, 0.1, 70]} }
    },
    "orange": {
      "200": { "$value": {"colorSpace": "oklch", "components": [0.8, 0.11, 40]} },
      "470": { "$value": {"colorSpace": "oklch", "components": [0.53, 0.15, 40]} }
    },
    "sky": {
      "150": { "$value": {"colorSpace": "oklch", "components": [0.85, 0.07, 215]} },
      "500": { "$value": {"colorSpace": "oklch", "components": [0.5, 0.09, 220]} }
    },
    "teal": {
      "120": { "$value": {"colorSpace": "oklch", "components": [0.88, 0.05, 180]} },
      "500": { "$value": {"colorSpace": "oklch", "components": [0.5, 0.08, 185]} }
    },
    "mint": {
      "140": { "$value": {"colorSpace": "oklch", "components": [0.86, 0.09, 165]} },
      "500": { "$value": {"colorSpace": "oklch", "components": [0.5, 0.1, 165]} }
    }
  },
  "color": {
    "$type": "color",
    "$description": "Semantic colors. Components use only these. Values here are the dark theme; light.json replaces them.",
    "surface": {
      "page": {
        "$value": "{palette.gray.855}",
        "$description": "The page."
      },
      "raised": {
        "$value": "{palette.gray.825}",
        "$description": "Toolbars, table heads, one step above the page."
      },
      "sunk": {
        "$value": "{palette.gray.880}",
        "$description": "Editors and the install box, one step below."
      },
      "terminal": {
        "$value": "{palette.gray.890}",
        "$description": "Compiler output."
      }
    },
    "text": {
      "primary": { "$value": "{palette.gray.50}" },
      "secondary": {
        "$value": "{palette.gray.230}",
        "$description": "Body copy and labels."
      },
      "tertiary": {
        "$value": "{palette.gray.370}",
        "$description": "Meta: counts, paths, line numbers."
      },
      "on-accent": { "$value": "{palette.lime.800}" },
      "on-accent-soft": { "$value": "{palette.lime.700}" },
      "on-state": {
        "$value": "{color.surface.page}",
        "$description": "Text on a warning fill."
      }
    },
    "border": { "default": {"$value": "{palette.gray.745}"}, "strong": {"$value": "{palette.gray.670}"} },
    "accent": {
      "text": {
        "$value": "{palette.lime.110}",
        "$description": "wagmi as text: a pass, the fn. in the headline, the tour's door."
      },
      "fill": {
        "$value": "{palette.lime.110}",
        "$description": "Primary buttons and the passed lesson."
      },
      "fill-hover": { "$value": "{palette.lime.70}" },
      "selection": { "$value": {"colorSpace": "oklch", "components": [0.89, 0.19, 128], "alpha": 0.25} }
    },
    "state": {
      "error": {
        "$value": "{palette.red.290}",
        "$description": "ngmi."
      },
      "warning": { "$value": "{palette.amber.150}" }
    },
    "syntax": {
      "keyword": { "$value": "{palette.violet.210}" },
      "string": { "$value": "{palette.sand.160}" },
      "number": { "$value": "{palette.orange.200}" },
      "type": { "$value": "{palette.sky.150}" },
      "function": { "$value": "{palette.teal.120}" },
      "macro": { "$value": "{palette.mint.140}" },
      "slang": {
        "$value": "{color.accent.text}",
        "$description": "typeshi's own words."
      },
      "comment": { "$value": "{color.text.tertiary}" }
    },
    "overlay": {
      "$description": "Tints laid over any surface.",
      "subtle": { "$value": {"colorSpace": "oklch", "components": [1, 0, 0], "alpha": 0.03} },
      "hover": { "$value": {"colorSpace": "oklch", "components": [1, 0, 0], "alpha": 0.05} },
      "chip": { "$value": {"colorSpace": "oklch", "components": [1, 0, 0], "alpha": 0.06} },
      "strong": { "$value": {"colorSpace": "oklch", "components": [1, 0, 0], "alpha": 0.08} }
    },
    "contrast": {
      "$description": "What contrast-more.json switches to.",
      "text": { "$value": "{palette.gray.140}" },
      "border": { "$value": "{palette.gray.370}" },
      "error": { "$value": "{palette.red.200}" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Geist", "Geist Fallback", "ui-sans-serif", "system-ui", "sans-serif"],
        "$extensions": { "com.tickerz.typeshi": {"cssVar": "--font-geist-sans"} }
      },
      "mono": {
        "$value": [
          "Geist Mono",
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "Liberation Mono",
          "monospace"
        ],
        "$extensions": { "com.tickerz.typeshi": {"cssVar": "--font-geist-mono"} }
      }
    },
    "step": {
      "$type": "dimension",
      "$description": "A fluid type scale (Utopia's method): each step has a size at 320 px and one at 1240 px, and clamp() moves between them. Ten steps, named for their job.",
      "$extensions": { "com.tickerz.typeshi": {"viewport": {"min": 320, "max": 1240}} },
      "label": {
        "$value": { "value": 11.5, "unit": "px" },
        "$extensions": { "com.tickerz.typeshi": {"max": {"value": 12, "unit": "px"}} },
        "$description": "Versions, counts, column heads, keys."
      },
      "code": {
        "$value": { "value": 12.5, "unit": "px" },
        "$extensions": { "com.tickerz.typeshi": {"max": {"value": 13.5, "unit": "px"}} },
        "$description": "Code, the terminal, and the monospace interface: navigation, buttons, tabs."
      },
      "small": {
        "$value": { "value": 14, "unit": "px" },
        "$extensions": { "com.tickerz.typeshi": {"max": {"value": 15, "unit": "px"}} },
        "$description": "Secondary sans text: notes, tables, the footer."
      },
      "body": {
        "$value": { "value": 16, "unit": "px" },
        "$description": "Body text."
      },
      "input": {
        "$value": { "value": 16, "unit": "px" },
        "$description": "Every field you type in or pick from on a touch screen: the editor, the example picker, the keyword search. Never under 16 px: iOS Safari zooms the page into a focused field under 16 px, and a zoomed page scrolls sideways. scripts/tokens.test.mjs and tests/phone.spec.ts hold it there."
      },
      "lede": {
        "$value": { "value": 17, "unit": "px" },
        "$extensions": { "com.tickerz.typeshi": {"max": {"value": 19, "unit": "px"}} },
        "$description": "The lede and the name in the header."
      },
      "subhead": {
        "$value": { "value": 20, "unit": "px" },
        "$extensions": { "com.tickerz.typeshi": {"max": {"value": 24, "unit": "px"}} },
        "$description": "The three proofs on the home, the doors out of it, and the page sections under a heading."
      },
      "title": {
        "$value": { "value": 30, "unit": "px" },
        "$extensions": { "com.tickerz.typeshi": {"max": {"value": 46, "unit": "px"}} },
        "$description": "Section headings, the statement on the home, lesson titles."
      },
      "heading": {
        "$value": { "value": 38, "unit": "px" },
        "$extensions": { "com.tickerz.typeshi": {"max": {"value": 64, "unit": "px"}} },
        "$description": "Page headings."
      },
      "display": {
        "$value": { "value": 60, "unit": "px" },
        "$extensions": { "com.tickerz.typeshi": {"max": {"value": 132, "unit": "px"}} },
        "$description": "lock in fn. Small enough at 320 px that it stays on one line."
      }
    },
    "leading": {
      "$type": "number",
      "display": { "$value": 0.92 },
      "heading": { "$value": 1.05 },
      "snug": { "$value": 1.35 },
      "body": { "$value": 1.6 },
      "code": { "$value": 1.65 }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "bold": { "$value": 600 },
      "heavy": {
        "$value": 700,
        "$description": "Display and page headings in Geist Sans."
      }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "4 px steps. The larger ones grow from 320 px to 1240 px.",
    "$extensions": { "com.tickerz.typeshi": {"viewport": {"min": 320, "max": 1240}} },
    "3xs": { "$value": {"value": 4, "unit": "px"} },
    "2xs": { "$value": {"value": 8, "unit": "px"} },
    "xs": { "$value": {"value": 12, "unit": "px"} },
    "s": { "$value": {"value": 16, "unit": "px"} },
    "m": {
      "$value": { "value": 20, "unit": "px" },
      "$extensions": { "com.tickerz.typeshi": {"max": {"value": 24, "unit": "px"}} }
    },
    "l": {
      "$value": { "value": 28, "unit": "px" },
      "$extensions": { "com.tickerz.typeshi": {"max": {"value": 32, "unit": "px"}} }
    },
    "xl": {
      "$value": { "value": 40, "unit": "px" },
      "$extensions": { "com.tickerz.typeshi": {"max": {"value": 48, "unit": "px"}} }
    },
    "2xl": {
      "$value": { "value": 56, "unit": "px" },
      "$extensions": { "com.tickerz.typeshi": {"max": {"value": 72, "unit": "px"}} }
    },
    "3xl": {
      "$value": { "value": 72, "unit": "px" },
      "$extensions": { "com.tickerz.typeshi": {"max": {"value": 112, "unit": "px"}} }
    }
  },
  "radius": {
    "$type": "dimension",
    "2xs": {
      "$value": { "value": 2, "unit": "px" },
      "$description": "Tiny marks: the tour's progress cells."
    },
    "xs": { "$value": {"value": 4, "unit": "px"} },
    "sm": { "$value": {"value": 8, "unit": "px"} },
    "md": { "$value": {"value": 10, "unit": "px"} }
  },
  "size": {
    "$type": "dimension",
    "control": {
      "$value": { "value": 36, "unit": "px" },
      "$description": "Buttons and selects with a mouse."
    },
    "target": {
      "$value": { "value": 44, "unit": "px" },
      "$description": "The smallest thing a finger has to hit."
    },
    "cta": {
      "$value": { "value": 48, "unit": "px" },
      "$description": "The main calls to action."
    },
    "header": {
      "$value": { "value": 56, "unit": "px" },
      "$description": "The sticky header."
    },
    "page": {
      "$value": { "value": 1180, "unit": "px" },
      "$description": "The widest column."
    }
  },
  "duration": {
    "$type": "duration",
    "press": { "$value": {"value": 120, "unit": "ms"} },
    "hover": { "$value": {"value": 150, "unit": "ms"} },
    "state": { "$value": {"value": 200, "unit": "ms"} },
    "page": { "$value": {"value": 400, "unit": "ms"} }
  },
  "easing": {
    "$type": "cubicBezier",
    "out": {
      "$value": [0.23, 1, 0.32, 1],
      "$description": "Most things: fast start, soft landing."
    },
    "in-out": {
      "$value": [0.65, 0, 0.35, 1],
      "$description": "Page slides."
    }
  }
}
