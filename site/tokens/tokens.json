  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Geist",
          "Geist Fallback",
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ],
        "$extensions": {
          "com.tickerz.typeshi": {
            "cssVar": "--font-geist-sans"
          }
        }
      },
      "mono": {
        "$value": [
          "Geist Mono",
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "Liberation Mono",
          "monospace"
        ],
        "$extensions": {
          "com.tickerz.typeshi": {
            "cssVar": "--font-geist-mono"
          }
        }
      }
    },
    "step": {
      "$type": "dimension",
      "$description": "A fluid type scale (Utopia's method): each step has a size at 320 px and one at 1240 px, and clamp() moves between them. Ten steps, named for their job.",
      "$extensions": {
        "com.tickerz.typeshi": {
          "viewport": {
            "min": 320,
            "max": 1240
          }
        }
      },
      "label": {
        "$value": {
          "value": 11.5,
          "unit": "px"
        },
        "$extensions": {
          "com.tickerz.typeshi": {
            "max": {
              "value": 12,
              "unit": "px"
            }
          }
        },
        "$description": "Versions, counts, column heads, keys."
      },
      "code": {
        "$value": {
          "value": 12.5,
          "unit": "px"
        },
        "$extensions": {
          "com.tickerz.typeshi": {
            "max": {
              "value": 13.5,
              "unit": "px"
            }
          }
        },
        "$description": "Code, the terminal, and the monospace interface: navigation, buttons, tabs."
      },
      "small": {
        "$value": {
          "value": 14,
          "unit": "px"
        },
        "$extensions": {
          "com.tickerz.typeshi": {
            "max": {
              "value": 15,
              "unit": "px"
            }
          }
        },
        "$description": "Secondary sans text: notes, tables, the footer."
      },
      "body": {
        "$value": {
          "value": 16,
          "unit": "px"
        },
        "$description": "Body text."
      },
      "input": {
        "$value": {
          "value": 16,
          "unit": "px"
        },
        "$description": "Every field you type in or pick from on a touch screen: the editor, the example picker, the keyword search. Never under 16 px: iOS Safari zooms the page into a focused field under 16 px, and a zoomed page scrolls sideways. scripts/tokens.test.mjs and tests/phone.spec.ts hold it there."
      },
      "lede": {
        "$value": {
          "value": 17,
          "unit": "px"
        },
        "$extensions": {
          "com.tickerz.typeshi": {
            "max": {
              "value": 19,
              "unit": "px"
            }
          }
        },
        "$description": "The lede and the name in the header."
      },
      "subhead": {
        "$value": {
          "value": 20,
          "unit": "px"
        },
        "$extensions": {
          "com.tickerz.typeshi": {
            "max": {
              "value": 24,
              "unit": "px"
            }
          }
        },
        "$description": "The three proofs on the home, the doors out of it, and the page sections under a heading."
      },
      "section": {
        "$type": "dimension",
        "$description": "A section's heading, Tickerz's h2: 24 to 32px.",
        "$value": {
          "value": 24,
          "unit": "px"
        },
        "$extensions": {
          "com.tickerz.typeshi": {
            "max": {
              "value": 32,
              "unit": "px"
            }
          }
        }
      },
      "title": {
        "$value": {
          "value": 30,
          "unit": "px"
        },
        "$extensions": {
          "com.tickerz.typeshi": {
            "max": {
              "value": 46,
              "unit": "px"
            },
            "fit": {
              "value": 11,
              "unit": "vw"
            }
          }
        },
        "$description": "Section headings, the statement on the home, lesson titles."
      },
      "heading": {
        "$value": {
          "value": 38,
          "unit": "px"
        },
        "$extensions": {
          "com.tickerz.typeshi": {
            "max": {
              "value": 64,
              "unit": "px"
            },
            "fit": {
              "value": 13,
              "unit": "vw"
            }
          }
        },
        "$description": "Page headings."
      },
      "display": {
        "$value": {
          "value": 60,
          "unit": "px"
        },
        "$extensions": {
          "com.tickerz.typeshi": {
            "max": {
              "value": 132,
              "unit": "px"
            },
            "fit": {
              "value": 19,
              "unit": "vw"
            }
          }
        },
        "$description": "lock in fn. 60 px at 320 px, so it stays on one line. Never over 19vw, so with large system text a word still fits on a phone."
      }
    },
    "leading": {
