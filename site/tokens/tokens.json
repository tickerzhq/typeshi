        "$description": "Meta: counts, paths, line numbers."
      },
      "on-accent": {
        "$value": "{palette.petrol.ground}"
      },
      "on-accent-soft": {
        "$value": "{palette.petrol.brand-deep}"
      },
      "on-state": {
        "$value": "{color.surface.page}",
        "$description": "Text on a warning fill."
      }
    },
    "border": {
      "default": {
        "$value": "{palette.petrol.line}"
