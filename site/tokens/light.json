{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "The light theme: the brand's light palette (brand/README.md), the same names as the dark one.",
  "color": {
    "surface": {
      "page": {
        "$value": "{palette.paper.ground}"
      },
      "raised": {
        "$value": "{palette.paper.panel}"
      },
      "sunk": {
        "$value": "{palette.paper.sunk}"
      },
      "terminal": {
        "$value": "{palette.paper.panel-2}"
      }
    },
    "text": {
      "primary": {
        "$value": "{palette.paper.text}"
      },
      "secondary": {
        "$value": "{palette.paper.text-2}"
      },
      "tertiary": {
        "$value": "{palette.paper.mute}"
      }
    },
    "border": {
      "default": {
        "$value": "{palette.paper.line}"
      },
      "strong": {
        "$value": "{palette.paper.line-strong}"
      }
    },
    "accent": {
      "text": {
        "$value": "{palette.paper.brand}"
      },
      "selection": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.4818,
            0.082,
            197.0
          ],
          "alpha": 0.2
        }
      }
    },
    "state": {
      "error": {
        "$value": "{palette.paper.down}"
      },
      "warning": {
        "$value": "{palette.amber.470}"
      }
    },
    "syntax": {
      "keyword": {
        "$value": "{color.text.primary}"
      },
      "string": {
        "$value": "{palette.sand.500}"
      },
      "number": {
        "$value": "{palette.orange.470}"
      },
      "type": {
        "$value": "{palette.sky.500}"
      },
      "function": {
        "$value": "{palette.teal.500}"
      },
      "macro": {
        "$value": "{palette.mint.500}"
      }
    },
    "overlay": {
      "subtle": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0,
            0,
            0
          ],
          "alpha": 0.025
        }
      },
      "hover": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0,
            0,
            0
          ],
          "alpha": 0.04
        }
      },
      "chip": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0,
            0,
            0
          ],
          "alpha": 0.05
        }
      },
      "strong": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0,
            0,
            0
          ],
          "alpha": 0.07
        }
      }
    },
    "contrast": {
      "text": {
        "$value": "{palette.paper.text}"
      },
      "border": {
        "$value": "{palette.paper.mute}"
      },
      "error": {
        "$value": "{palette.paper.down}"
      }
    }
  }
}
