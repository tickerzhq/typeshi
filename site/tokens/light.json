{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "The light theme: the brand's light palette (brand/README.md), the same names as the dark one.",
  "color": {
    "surface": {
      "page": { "$value": "{palette.gray.0}" },
      "raised": { "$value": "{palette.gray.15}" },
      "sunk": { "$value": "{palette.gray.25}" },
      "terminal": { "$value": "{palette.gray.35}" }
    },
    "text": {
      "primary": { "$value": "{palette.gray.780}" },
      "secondary": { "$value": "{palette.gray.560}" },
      "tertiary": { "$value": "{palette.gray.470}" }
    },
    "border": { "default": {"$value": "{palette.gray.80}"}, "strong": {"$value": "{palette.gray.140}"} },
    "accent": {
      "text": { "$value": "{palette.lime.480}" },
      "selection": { "$value": {"colorSpace": "oklch", "components": [0.52, 0.15, 135], "alpha": 0.2} }
    },
    "state": { "error": {"$value": "{palette.red.460}"}, "warning": {"$value": "{palette.amber.470}"} },
    "syntax": {
      "keyword": { "$value": "{palette.violet.500}" },
      "string": { "$value": "{palette.sand.500}" },
      "number": { "$value": "{palette.orange.470}" },
      "type": { "$value": "{palette.sky.500}" },
      "function": { "$value": "{palette.teal.500}" },
      "macro": { "$value": "{palette.mint.500}" }
    },
    "overlay": {
      "subtle": { "$value": {"colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0.025} },
      "hover": { "$value": {"colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0.04} },
      "chip": { "$value": {"colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0.05} },
      "strong": { "$value": {"colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0.07} }
    },
    "contrast": {
      "text": { "$value": "{palette.gray.670}" },
      "border": { "$value": "{palette.gray.470}" },
      "error": { "$value": "{palette.red.460}" }
    }
  }
}
